#!/usr/bin/env python3
"""Add two numbers supplied as arguments or on standard input."""

import sys


def main() -> int:
    values = sys.argv[1:] or sys.stdin.read().split()
    if len(values) != 2:
        print("Usage: python NewText <number1> <number2>", file=sys.stderr)
        return 1

    try:
        result = float(values[0]) + float(values[1])
    except ValueError:
        print("Both inputs must be numbers.", file=sys.stderr)
        return 1

    print(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
